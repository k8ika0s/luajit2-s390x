{
  "schema_version": 1,
  "name": "upstream-validation-performance-matrix",
  "updated_at": "2026-04-21",
  "purpose": "Define a single upstreamable validation and performance matrix that can be executed on any installed architecture without embedding transport, host, or comparison policy into the test definition.",
  "principles": [
    "The matrix defines what to test, not where or how to dispatch execution.",
    "Validation coverage and performance coverage are both first-class and live in the same definition.",
    "Architecture-specific applicability is expressed as scope metadata, not as deployment or host configuration.",
    "The matrix must be verbose enough to produce the same report shape on every architecture, even when some lanes are not applicable."
  ],
  "non_goals": [
    "No hostnames, SSH targets, remote mirrors, or transport details.",
    "No architecture-to-architecture comparison policy.",
    "No branch-local deployment gates such as downstream demos or environment-specific smoke wrappers."
  ],
  "report_shape": {
    "validation_rows": [
      "lane",
      "variant",
      "status",
      "applicability",
      "coverage_tags",
      "source_paths"
    ],
    "performance_rows": [
      "family",
      "variant",
      "workload",
      "scale",
      "status",
      "median_runtime_sec",
      "p95_runtime_sec",
      "coverage_tags",
      "source_path"
    ]
  },
