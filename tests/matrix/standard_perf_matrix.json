{
  "schema_version": 1,
  "name": "standard-performance-matrix",
  "updated_at": "2026-04-23",
  "purpose": "Define the canonical cross-architecture performance matrix with explicit jit-off, jit-on, and accelerated JIT profiles, without mutating the validation matrix or relying on shell-local environment overrides.",
  "principles": [
    "The standard perf matrix is the canonical source for repeatable cross-architecture performance runs.",
    "Profile differences are encoded as matrix variants, not ad hoc shell environment.",
    "The same matrix file must run unchanged on s390x, x86, and arm64 targets.",
    "The report contract is stable: the matrix exists to feed combined-comparison and family-rollup artifacts."
  ],
  "non_goals": [
    "No validation lanes in this file; validation remains in upstream_validation_perf_matrix.json.",
    "No hostnames, SSH targets, or architecture-to-architecture comparison policy.",
    "No benchmark-family narrowing to hide failing or inconvenient rows."
  ],
  "report_shape": {
    "validation_rows": [
      "lane",
      "variant",
      "status",
      "applicability",
      "coverage_tags",
      "source_paths"
    ],
    "performance_rows": [
      "family",
      "variant",
      "workload",
      "scale",
      "status",
      "median_runtime_sec",
      "p95_runtime_sec",
      "coverage_tags",
      "source_path"
    ]
  },
  "variant_sets": {
    "performance_standard": [
      {
        "id": "gcc-release-jit-off",
        "compiler": "gcc",
        "mode": "release",
        "jit": "off",
        "ffi": "on",
        "build_style": "mixed"
      },
      {
        "id": "gcc-release-jit-on",
        "compiler": "gcc",
        "mode": "release",
        "jit": "on",
        "ffi": "on",
        "build_style": "mixed"
      },
      {
        "id": "gcc-release-jit-accel-h1e10",
